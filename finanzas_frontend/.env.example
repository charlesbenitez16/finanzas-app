# En desarrollo no hace falta definir nada: el proxy de Vite (ver vite.config.ts)
# reenvía /api/* a http://localhost:8000, así que el front y el back
# funcionan como si fueran el mismo origen.
#
# En producción, si el front no se sirve detrás del mismo dominio/reverse
# proxy que el backend, definí acá la URL completa del backend:
# VITE_API_BASE_URL=https://api.tu-dominio.com
